<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contrain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#B9DDF3"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtNombreTareaLista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/txtHoraTareaLista"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Estudiar Java" />

        <TextView
            android:id="@+id/txtHoraTareaLista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#2563EB"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="18:30" />

        <!-- Ubica la repetición debajo del nombre y de la hora. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barreraDatosTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="txtNombreTareaLista,txtHoraTareaLista" />

        <TextView
            android:id="@+id/txtRepeticionTatrea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#475569"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barreraDatosTarea"
            tools:text="Lun, Mar, Mié, Jue, Vie" />

        <View
            android:id="@+id/divisorAccionesTarea"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E2E8F0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtRepeticionTatrea" />

        <ImageButton
            android:id="@+id/btnEditarTarea"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar tarea"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_editar"
            app:tint="#2563EB"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divisorAccionesTarea" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Eliminar tarea"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="×"
            android:textColor="#B91C1C"
            android:textSize="28sp"
            app:backgroundTint="#FEF2F2"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="@id/btnEditarTarea"
            app:layout_constraintStart_toEndOf="@id/btnEditarTarea"
            app:layout_constraintTop_toTopOf="@id/btnEditarTarea" />

        <Switch
            android:id="@+id/switchActivaTarea"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:contentDescription="Activar o desactivar tarea"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:switchMinWidth="48dp"
            app:layout_constraintBottom_toBottomOf="@id/btnEditarTarea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnEditarTarea" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>