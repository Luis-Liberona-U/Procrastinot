<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.EditarTareaActivity">

    <ScrollView
        android:id="@+id/scrollEditarTarea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layoutContenedorFormularioEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtTituloEditarTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Editar tarea"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreTareaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nombre de la tarea"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreTareaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Ej.: Limpiar cocina"
                android:inputType="textCapSentences"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTituloDescripcionEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Descripción (opcional)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescripcionTareaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="top"
                android:hint="¿Qué necesitas hacer?"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTituloHoraEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Hora de inicio"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHoraInicioEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:minHeight="48dp"
                android:text="Seleccionar hora"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTituloRepeticionEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repetición"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgRepeticionEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbUnaVez"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:checked="true"
                    android:text="Una vez" />

                <RadioButton
                    android:id="@+id/rbTodosLosDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Todos los días" />

                <RadioButton
                    android:id="@+id/rbLunesaAViernes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Lunes a viernes" />

                <RadioButton
                    android:id="@+id/rbElegirDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Personalizar" />

            </RadioGroup>

            <TextView
                android:id="@+id/txtDuracionEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Duración estimada"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDuracionEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Duración en minutos"
                android:inputType="number"
                android:minHeight="48dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnGuardarTareaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="Guardar cambios"
                android:textAllCaps="false" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>